{
  "name": "hackillinois-waveshift-nexus",
  "version": "1.0.0",
  "description": "High-Performance Volunteer Scheduling & Operations Engine for HackIllinois Systems Team",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed/seedData.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --coverage --detectOpenHandles --forceExit",
    "lint": "tsc --noEmit",
    "demo": "tsx scripts/devSeeded.ts",
    "campus": "python3 design/build-campus.py",
    "bench:load": "NODE_ENV=test tsx scripts/benchmarks/loadtest.ts",
    "bench:sse": "NODE_ENV=test tsx scripts/benchmarks/sse-fanout.ts",
    "bench:fuzz": "NODE_ENV=test tsx scripts/benchmarks/fuzz.ts",
    "bench:pipeline": "tsx scripts/benchmarks/pipeline-check.ts",
    "csp:audit": "node scripts/cspAudit.mjs"
  },
  "keywords": [
    "hackillinois",
    "systems",
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "zod",
    "concurrency",
    "scheduling"
  ],
  "author": "HackIllinois Systems Candidate",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

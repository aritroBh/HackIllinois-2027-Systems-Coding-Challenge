{
  // The production build.
  //
  // `rootDir` is the repository root rather than `src`, because the plugin registry imports
  // the bundled example from `plugins/hello-nexus` and TypeScript refuses to compile a file
  // outside the declared root. That import is deliberate and is what the plan asks for: a
  // plugin that is statically imported is one `tsc` type-checks, so a plugin that no longer
  // matches the hook interface is a compile error rather than something that throws at the
  // first check-in of the event. Excluding it instead would trade a real guarantee for a
  // tidier output path.
  //
  // The cost is that the output is `dist/src/index.js` rather than `dist/index.js`. That is
  // stated once here and once in `package.json`'s `start`, and nowhere else — the alternative
  // of two `rootDirs` produces the same layout with a less obvious reason.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "plugins/**/*"],
  "exclude": ["node_modules", "dist", "tests", "scripts", "design"]
}

node_modules
dist
.env
coverage
*.log
.DS_Store
.gstack/

# Cached OpenStreetMap extracts (~6.5 MB). The committed .overpass queries
# refetch them; public/gl/uiuc-campus.json is the built artefact that ships.
design/osm/*.json
design/osm/cache/

# The pipeline provenance manifest is small and worth tracking; the raw OSM extracts are not.
!design/osm/manifest.json
design/.venv/

# Python bytecode. Committed by accident once; a .pyc is a build artefact of a
# specific interpreter version and tells a reader nothing the .py does not.
__pycache__/
*.pyc

# Compiled plugin sources. `npm run build` emits these into dist/; a stray copy beside
# the .ts confuses nothing at runtime but is a build artefact in the source tree.
plugins/**/*.js
!plugins/**/public/*.js

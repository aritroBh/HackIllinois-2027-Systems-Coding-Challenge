# Server Configuration
PORT=3000
NODE_ENV=development
# Origin the browser sees; used for magic-link URLs, the Adonix redirect and the
# WebSocket Origin check. Set to your public https URL in production.
PUBLIC_URL=http://localhost:3000

# Database Configuration
# Leave blank in development/test to use an automatic in-memory MongoDB replica set.
# REQUIRED in production: the process refuses to boot without it (in-memory Mongo
# would lose every roster, karma total and ticket on restart).
MONGODB_URI=

# Security
# Secrets are compared against their committed defaults at boot; production refuses
# to start while any is still the default. Outside production QR_HMAC_SECRET and
# SESSION_SECRET are replaced by random per-boot values.
QR_HMAC_SECRET=hackillinois_waveshift_secret_key_2027
SESSION_SECRET=nexus_session_change_me
ORGANIZER_SECRET=waveshift_change_me_in_production

# Identity
# legacy   = open demo: a body/query volunteerId is believed, anonymous reads allowed.
# required = the session cookie is the only identity; anonymous API calls are 401
#            except the sign-in endpoints. Production refuses to boot unless required.
# REQUIRE_AUTH=true is accepted as a deprecated alias for AUTH_MODE=required.
AUTH_MODE=legacy
# Email magic links: set an SMTP URL (smtp://user:pass@host:587) to enable in
# production; in development the link is printed to the server log instead.
SMTP_URL=
MAIL_FROM=Nexus Quest <no-reply@nexus.local>
# Adonix (HackIllinois SSO). Enable explicitly; the URL is never taken from a content
# pack. Set ADONIX_JWT_SECRET to verify HS256 tokens locally, otherwise tokens are
# exchanged against ADONIX_URL with a 4 s timeout.
ADONIX_ENABLED=false
ADONIX_URL=https://adonix.hackillinois.org
ADONIX_JWT_SECRET=
# Comma-separated IPv4 CIDRs of the venue's NAT egress. Per-IP anti-abuse ceilings do
# not apply to them (capacity is controlled per account).
# The venue's NAT egress ranges, comma-separated. IPv4 only — an IPv6 entry is ignored with a
# warning at boot, so check the console rather than assuming an allowlist took effect.
TRUSTED_EGRESS_CIDRS=

# CORS
CORS_ORIGIN=*

# Hardening flags
# Reject gym battles that omit GPS coordinates, closing the remote-capture bypass.
# (Attendance check-in always requires coordinates regardless of this flag.)
REQUIRE_GEOFENCE=false
# Deprecated alias for AUTH_MODE=required (also gates X-Organizer-Secret in legacy mode).
REQUIRE_AUTH=false

# Capacity
# Authenticated per-account API budget per window. Anonymous traffic is limited per IP
# (600/min, 3,000/min sum ceiling) — set TRUST_PROXY_HOPS to the real number of proxies
# in front of this process so client IPs resolve correctly.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY_HOPS=0

# HTTP socket timeouts (ms). Keep REQUEST > HEADERS > KEEP_ALIVE. Behind a 60 s
# proxy idle timeout use KEEP_ALIVE_TIMEOUT_MS=65000 and HEADERS_TIMEOUT_MS=70000.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=10000

# --- Live presence and plugins (M4, M8) ---------------------------------------
# Presence is the multiplayer layer: opt-in per account, positions never stored.
# Set to false to run the event without it.
PRESENCE_ENABLED=true
# Comma-separated plugin names to activate. Every plugin in the tree is compiled;
# this decides which ones run. Empty means none.
PLUGINS=

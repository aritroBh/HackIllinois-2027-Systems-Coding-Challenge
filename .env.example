# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Leave blank to use automatic in-memory MongoDB replica set)
MONGODB_URI=

# Security
QR_HMAC_SECRET=hackillinois_waveshift_secret_key_2027
JWT_SECRET=waveshift_development_jwt_secret_key

# CORS
CORS_ORIGIN=*

# Hardening flags (all default to open-demo behavior; enable in production)
# Reject attendance verifications and gym battles that omit GPS coordinates,
# closing the remote check-in / remote-capture bypass.
REQUIRE_GEOFENCE=false
# Require X-Organizer-Secret on all mutating API routes (POST/PATCH/PUT/DELETE).
REQUIRE_AUTH=false
# Shared organizer secret enforced when REQUIRE_AUTH=true. Change in production.
ORGANIZER_SECRET=waveshift_change_me_in_production

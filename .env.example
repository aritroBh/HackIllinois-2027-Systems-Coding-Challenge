# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Leave blank in development/test to use an automatic in-memory MongoDB replica set.
# REQUIRED in production: the process refuses to boot without it (in-memory Mongo
# would lose every roster, karma total and ticket on restart).
MONGODB_URI=

# Security
# Both secrets are compared against their committed defaults at boot; production
# refuses to start while either is still the default. Outside production the QR
# secret is replaced by a random per-boot value.
QR_HMAC_SECRET=hackillinois_waveshift_secret_key_2027
ORGANIZER_SECRET=waveshift_change_me_in_production

# CORS
CORS_ORIGIN=*

# Hardening flags (default to open-demo behaviour; production requires both true)
# Reject gym battles that omit GPS coordinates, closing the remote-capture bypass.
# (Attendance check-in always requires coordinates regardless of this flag.)
REQUIRE_GEOFENCE=false
# Require X-Organizer-Secret on all mutating API routes (POST/PATCH/PUT/DELETE).
# Production refuses to boot unless this is true.
REQUIRE_AUTH=false

# Capacity
# Per-client API budget per window. Behind campus NAT many phones share one IP, so
# set TRUST_PROXY_HOPS to the real number of proxies in front of this process.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY_HOPS=0

# HTTP socket timeouts (ms). Keep REQUEST > HEADERS > KEEP_ALIVE. Behind a 60 s
# proxy idle timeout use KEEP_ALIVE_TIMEOUT_MS=65000 and HEADERS_TIMEOUT_MS=70000.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=10000
